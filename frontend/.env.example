# Archivo de Ejemplo (.env.example) para Entornos Frontend
# =========================================================

# Variables requeridas por Next.js para contactar con Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI..._tu_clave_anonima_publica_aqui_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000

# Opcional: evita conflictos de OneDrive/locks para artefactos de build
NEXT_DIST_DIR=.next-build

# Variable reservada para una futura integracion publica de Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_..._tu_clave_publica_de_stripe_...
