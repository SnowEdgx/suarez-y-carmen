PORT=4000
NODE_ENV=development

# URL de la aplicación Frontend para CORS y redirecciones de Stripe
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe Backend (Integración de pagos)
STRIPE_SECRET_KEY=sk_test_..._tu_clave_secreta_de_stripe_...
STRIPE_WEBHOOK_SECRET=whsec_..._tu_secreto_de_webhook_...

# Supabase Admin (Opcional, sólo si el backend necesita acceso de admin)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci..._tu_service_role_key_aqui_...

# Si ejecutas backend dentro de Docker, usa:
# RUNNING_IN_DOCKER=true
# SUPABASE_URL=http://host.docker.internal:54321
