PORT=4000
NODE_ENV=development
ENABLE_SUPABASE_TEST_ENDPOINT=false
TRUST_PROXY=false

# URL de la aplicacion frontend para CORS y redirecciones de Stripe
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe backend (integracion de pagos)
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret

# Supabase admin (obligatorio para webhooks, checkout y URLs firmadas)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_VIDEO_BUCKET=course-videos
SUPABASE_RESOURCE_BUCKET=course-resources
VIDEO_SIGNED_URL_TTL_SECONDS=900
VIDEO_PLAYBACK_TOKEN_SECRET=change_me_with_a_long_random_video_token
VIDEO_PLAYBACK_TOKEN_TTL_SECONDS=900
COURSE_RESOURCE_TOKEN_TTL_SECONDS=300
COURSE_RESOURCE_TOKEN_SECRET=change_me_with_a_long_random_resource_token
VIDEO_AUDIT_HASH_SECRET=change_me_with_a_long_random_video_audit_token
VIDEO_MAX_ACTIVE_DEVICES=2
VIDEO_DEVICE_INACTIVITY_DAYS=30

# Sincronizacion editorial desde Strapi hacia Supabase operativo
CMS_SYNC_TOKEN=change_me_with_a_long_random_local_token

# Seed local opcional
# SEED_VIDEO_SOURCE_URL=https://example.com/seed-video.mp4
# SKIP_SEED_VIDEO_UPLOAD=1
# SKIP_SEED_RESOURCE_UPLOAD=1

# Si ejecutas backend dentro de Docker, usa:
# RUNNING_IN_DOCKER=true
# SUPABASE_URL=http://host.docker.internal:54321

# Pruebas E2E locales de Stripe (opcional; si se omiten, el script crea un alumno local de prueba)
E2E_BACKEND_URL=http://localhost:4000
E2E_USER_EMAIL=student.e2e@suarezycarmen.test
E2E_USER_PASSWORD=replace_with_local_test_password
E2E_COURSE_SLUG=bachazouk-vol-1-tilted-turns
# Opcional: define otro curso publicado para comprobar acceso bloqueado sin compra
E2E_UNOWNED_COURSE_SLUG=
