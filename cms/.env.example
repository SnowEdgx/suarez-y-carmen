HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
# STRAPI_PUBLIC_URL=http://localhost:1337
STRAPI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:1337,http://127.0.0.1:1337

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=syc_cms
DATABASE_USERNAME=syc_cms
DATABASE_PASSWORD=change_me_local_only
DATABASE_SSL=false

APP_KEYS=change_me_key_1,change_me_key_2
API_TOKEN_SALT=change_me_api_token_salt
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
ADMIN_ENCRYPTION_KEY=change_me_admin_encryption_key
TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
JWT_SECRET=change_me_jwt_secret

# Optional admin session tuning, in seconds.
ADMIN_ACCESS_TOKEN_LIFESPAN=1800
ADMIN_MAX_REFRESH_TOKEN_LIFESPAN=2592000
ADMIN_IDLE_REFRESH_TOKEN_LIFESPAN=604800
ADMIN_MAX_SESSION_LIFESPAN=604800
ADMIN_IDLE_SESSION_LIFESPAN=3600

# Obligatoria en produccion. Usar URL base sin query, hash ni credenciales.
CMS_SYNC_BACKEND_URL=http://localhost:4000
CMS_SYNC_TOKEN=change_me_with_the_same_backend_token
CMS_SYNC_TIMEOUT_MS=5000
CMS_SYNC_STRICT=false

STRAPI_TELEMETRY_DISABLED=true

# Produccion: activar storage persistente para uploads publicos de Strapi.
# Compatible con AWS S3 y proveedores S3-compatible como Cloudflare R2.
# Mantener `local` solo para desarrollo con disco persistente controlado.
UPLOAD_PROVIDER=local
# UPLOAD_PROVIDER=aws-s3
# UPLOAD_SIZE_LIMIT_BYTES=26214400
# UPLOAD_S3_ACCESS_KEY_ID=replace_with_storage_access_key
# UPLOAD_S3_SECRET_ACCESS_KEY=replace_with_storage_secret_key
# UPLOAD_S3_REGION=auto
# UPLOAD_S3_BUCKET=replace_with_storage_bucket
# UPLOAD_S3_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
# UPLOAD_S3_BASE_URL=https://replace_with_public_cdn_domain
# UPLOAD_S3_ROOT_PATH=strapi-uploads
# UPLOAD_S3_FORCE_PATH_STYLE=false
